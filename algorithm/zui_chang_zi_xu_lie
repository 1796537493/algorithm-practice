/*给定一个顺序存储的线性表，请设计一个算法查找该线性表中最长的连续递增子序列。
例如，(1,9,2,5,7,3,4,6,8,0)中最长的递增子序列为(3,4,6,8)。*/
#include<iostream>
#include<vector>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++){
        cin>>v[i];
    }
    int cur_start=0;
    int cur_length=1;
    int max_start=0;
    int max_length=1;
    for(int i=0;i<n-1;i++){
        if(v[i+1]>v[i]){cur_length++;}
        else{
            if(cur_length>max_length){
                max_length=cur_length;
                max_start=cur_start;
            }
            cur_start=i+1;
            cur_length=1;
        }
    }
    if(cur_length>max_length){
        max_length=cur_length;
        max_start = cur_start;
    }
    for(int i=max_start;i<max_start + max_length-1;i++){
        cout<<v[i]<<" ";
    }
    cout<<v[max_start+max_length-1];
}